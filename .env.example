# EXENOM Environment Variables
# Copy this file to .env and fill in your API keys.
# All keys are OPTIONAL — the tool works with pre-configured defaults.

# ─── Threat-Intelligence API Keys (multi-key, comma-separated) ──────────────
# The tool rotates through all keys, falling back to the next on rate limits.

# Shodan (https://www.shodan.io/)
EASM_SHODAN_KEYS=key1,key2

# c99 (https://api.c99.nl/)
EASM_C99_KEYS=key1,key2,key3

# VirusTotal (https://www.virustotal.com/)
EASM_VIRUSTOTAL_KEYS=key1,key2

# SecurityTrails (https://securitytrails.com/)
EASM_SECURITYTRAILS_KEYS=key1
